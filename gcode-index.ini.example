; ============================================================
; G-code Backup Indexer — example instance settings
; Copy next to gcode-index-gui.exe as: gcode-index.ini
;
; Every available setting is listed below with a short comment.
; Ustawienia wracają po restarcie — the GUI reloads this file on start
; and rewrites it when you change folders / filters / options.
;
; Deploy tip:
;   Shop / floor PCs  →  can_index = no
;   Indexer PC        →  can_index = yes
; ============================================================

[capabilities]
; Primary capability for THIS PC (edit the .ini — not a runtime toggle).
; yes = indexer: scan, map, watch, schedule, backup/extra folder setup
; no  = floor client: search + preview + extract (open DB / path remap / extract folder)
; Accepted yes values: yes, true, 1, on, tak, full, index, indexer
; Accepted no  values: no, false, 0, off, nie, simple, client, retrieve
; If this section/key is missing, legacy [ui] mode=simple|full is migrated
; (simple → no, full → yes).
can_index = no
; Deploy-time lock: yes = force retrieve-only (ignores can_index=yes).
; Same effect as empty operator.lock or can_index.lock next to this ini / exe.
; Use on shop floor PCs so editing can_index alone cannot elevate to indexer.
settings_locked = no

[folders]
; Main CNC backup tree (usually DATE\MACHINE\... dumps + .nc files).
; Required on the indexer; optional on floor clients that only open a shared DB.
backup = D:\CNC\Backups
; Database folder — gcode_index.sqlite + sidecar yaml (machine_folders,
; folder_tree_map, folder_colour_aliases, aliases.local, views.yaml, …)
target = D:\CNC\Index
; Extract / Wydobądź output folder. Leave blank to use the database folder.
; Legacy key extract_folder= is still accepted when loading.
extract = D:\CNC\Extracted
; Recent Extract to… destinations (newest first). One path per indented line.
extract_recent =

[green_roots]
; ON-MACHINE catch folders (green flag). One full path per indented line.
; Subfolders are scanned recursively. Used when can_index=yes.
; Also mirrored to extra_scan_roots.yaml next to the DB (INI is primary).
paths =
    D:\CNC\MachineCatch
    D:\CNC\USB_Stick_Copy

[yellow_roots]
; EXTRA folders (yellow flag) — not from the machine backup.
; One full path per indented line. Subfolders are scanned recursively.
; Used when can_index=yes.
paths =
    D:\CNC\Archive_Extra

; Optional legacy combined section (also loaded if present):
; [scan_roots]
; root1 = green|D:\CNC\MachineCatch
; root2 = yellow|D:\CNC\Archive_Extra

[ui]
; Language: pl (default) or en
language = pl
; Legacy mirror of [capabilities] can_index (simple = no, full = yes).
; Prefer can_index above; kept so older tools / notes still make sense.
mode = simple
; Auto-index while the GUI stays open (indexer / can_index=yes only).
; Values: off | 30s | 15m | 2h | 1d  (legacy: hourly→1h, daily→1d, weekly→7d)
schedule = off
; Last successful auto/manual index time (UTC ISO). Leave blank to force soon.
schedule_last_run =

[scan]
; yes/no — skip unchanged files when re-indexing (size + mtime cache)
incremental = yes
; yes/no — watch backup/extra folders and incremental-index on drop (indexer)
watch_folders = no
; Watch method when watch_folders=yes (indexer only):
;   hybrid = Auto — OS events on local disks, stamp-poll on network/UNC (Z:\, \\server\share)
;   poll   = stamp-poll everywhere (safe fallback / previous behavior)
; Aliases: auto / hybryda → hybrid; safe / stamp → poll
watch_mode = hybrid
; yes/no — also write gcode_index.xlsx after a successful scan (indexer)
also_excel = no
; yes/no — default "newest only" (one row per program+machine) on startup
newest_only = no
; yes/no — when filtering by machines, still show MACHINE UNKNOWN / unassigned (default yes)
; Floor clients (can_index=no / operator.lock) keep this on — control is disabled.
include_unknown = yes
; yes/no — auto-add role system_programs for program numbers O9000–O9099 (accumulate)
; Reindex to backfill / drop old broad O9… tags outside that range
o9_system_programs_role = yes
; yes/no — when yes, function/role colours overshadow green/yellow for the results row
; Default no: status (on-machine / unknown) always colours the row / primary flag
role_colours_overshadow_status = no
; yes/no — auto-refresh search when gcode_index.sqlite mtime changes (clients)
search_auto_refresh = no
; Seconds between DB mtime checks while auto-refresh is on (minimum 5)
search_auto_refresh_s = 20

[window]
; Width x height (+optional +X+Y). Saved on resize / quit / close-to-tray.
geometry = 1320x820

[notes]
; Free-form note for this PC / shop (optional; rewritten by the GUI)
text = Shop floor PC — set can_index=no; indexer PC uses can_index=yes

[path_remap]
; Client extract remaps when the indexer and this PC use different drive letters
; for the same share (e.g. indexer C:\CNC\Share → client Z:\CNC\Share).
; Applies to scan_root for main backup AND green/yellow roots on that prefix.
; Several rules allowed — longest matching from-prefix wins at extract/preview.
; Shorthand single pair (also counted as the first rule):
from_prefix = C:\CNC\Share
to_prefix = Z:\CNC\Share
; All rules (optional), one indented line each: FROM => TO
rules =
;     C:\Extra => Z:\Extra
;     \\server\share => Z:\Share

[desktop]
; Windows logon autostart (indexer helper). yes/no
autostart = no
; How to register autostart: startup = Startup folder shortcut | task = Task Scheduler ONLOGON
autostart_via = startup
; Window X closes to tray (yes) or quits (no) — indexer / tray builds
close_to_tray = yes
; Minimize / iconify also hides to tray
minimize_to_tray = yes

[filters]
; Last find-bar state — restored on every restart (no re-typing filters).
; Blank = no filter / “(all)”. machines = one name per line (or comma-separated).
text =
machines =
date_from =
date_to =
size_min =
size_max =
mtime_from =
mtime_to =
; Source type code (loose_nc, haas_pgm_glued, …) or blank
source_type =
; Control family (haas / fanuc / sinumerik) or blank
control =
; Status: blank = all | backup = on-machine 🟢 | extra = not-run 🟡
status =
; Role catalogue id (production / wip / fixture / …) or blank
role =
; Programmer flag (LP1 / MS1) or blank
programmer =
; Odbiorca id, __missing__ = no recipient, or blank = all
odbiorca =

[session]
; Results table sort column id (flag / program / part / machine / date / size / …)
sort_col =
sort_reverse = no
; yes = More filters panel open
more_filters = no
; Folders panel: yes = path editors open | no = summary strip | blank = auto
folders_expanded =
; Indexer nav: praca | indeks
pelny_view = praca
; Preview “find in program” last string
preview_find =
; Results columns to hide (comma-separated ids: flag,src,program,part,…)
hidden_columns =
; Results column widths (id=pixels). Blank = defaults; GUI updates on resize.
; Separator drag resizes adjacent columns (no empty gutter); widths fill the frame.
column_widths =
; Preview popup geometry (also under [window])
preview_geometry =

; ------------------------------------------------------------
; Sidecars next to the database folder (paths implied by [folders] target=).
; Auto-loaded on start / scan / Map dialogs — never delete casually:
;   machine_folders.yaml       — Map folders… (date/machine → machine id)
;   aliases.local.yaml         — Machines & aliases…
;   folder_colour_aliases.yaml — Folder roles… (catalogue + name→role/exclude)
;   folder_tree_map.yaml       — Map tree… (path machine + multi-tags + exclude)
;   extra_scan_roots.yaml      — mirror of green/yellow (INI [green_roots]/[yellow_roots] wins)
;   views.yaml                 — named find-bar views (Save current…)
;   filter_presets.yaml        — legacy views filename (still loaded if views.yaml absent)
;   ui_settings.yaml           — optional schedule_last_run mirror
;   scan_history.json          — scan run history
; ------------------------------------------------------------
