; ============================================================
; G-code Backup Indexer — example instance settings
; Copy next to gcode-index-gui.exe as: gcode-index.ini
; ============================================================

[folders]
; Main CNC backup tree (usually DATE\MACHINE\... dumps + .nc files)
backup = D:\CNC\Backups
; Database folder — gcode_index.sqlite + sidecar yaml live here
target = D:\CNC\Index
; Extract / Wydobądź output (leave blank to use the database folder)
extract = D:\CNC\Extracted

[green_roots]
; ON-MACHINE catch folders (green flag). One full path per indented line.
; Subfolders are scanned recursively.
paths =
    D:\CNC\MachineCatch
    D:\CNC\USB_Stick_Copy

[yellow_roots]
; EXTRA folders (yellow flag) — not from the machine backup.
paths =
    D:\CNC\Archive_Extra

[ui]
; Language: pl (default) or en
language = pl
; Mode: simple (retrieve-only operators) or full (index + power users)
mode = simple
; Auto-index while GUI open: off | 30s | 15m | 2h | 1d (legacy: hourly/daily/weekly)
schedule = off
schedule_last_run =

[scan]
incremental = yes
watch_folders = no
also_excel = no
newest_only = no

[window]
geometry = 1320x820

[notes]
text = Shop floor PC — edit paths above if drives change


[path_remap]
; Client extract remaps when indexer and this PC use different drive letters
; for the same share (e.g. indexer C:\CNC\Share → client Z:\CNC\Share).
; Applies to scan_root for main backup AND green/yellow roots on that prefix.
from_prefix = C:\CNC\Share
to_prefix = Z:\CNC\Share
; Extra rules (optional), one per line: FROM => TO
rules =

